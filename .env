# App config
APP_NAME=go-api-server
APP_ENVIRONMENT=development
APP_PORT=8080
JWT_SECRET=TEST
# DB config
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=alpha123
DB_NAME=go_api_server
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
# Redis config
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Logger config
LOG_LEVEL=debug
# SMTP config
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
